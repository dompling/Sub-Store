# Address and port published by Docker Compose on the host.
SUB_STORE_BACKEND_BIND_ADDRESS=127.0.0.1
SUB_STORE_BACKEND_PORT=3000

# Keep the named volume by default. Set an absolute host path such as
# /root/sub-store-data to use the bind-mount style documented by xream/sub-store.
SUB_STORE_DATA_PATH=sub-store-data

# Use an exact comma-separated browser-origin allowlist. These defaults support
# the local Front-End dev server plus the official hosted Front-End.
SUB_STORE_CORS_ALLOWED_ORIGINS=http://localhost:8888,http://127.0.0.1:8888,https://sub-store.vercel.app

# Protect extension install, enable, disable, and uninstall operations when the
# backend is reachable by other users. Set either the plain token or its
# lowercase SHA-256 hex digest, not both.
# SUB_STORE_EXTENSION_ADMIN_TOKEN=replace-with-a-long-random-token
# SUB_STORE_EXTENSION_ADMIN_TOKEN_HASH=

# Common variables supported by the official xream/sub-store deployment.
# SUB_STORE_BACKEND_SYNC_CRON="55 23 * * *"
# SUB_STORE_PUSH_SERVICE=
# SUB_STORE_BACKEND_DEFAULT_PROXY=socks5://127.0.0.1:7890
# SUB_STORE_BACKEND_DOWNLOAD_CRON=
# SUB_STORE_BACKEND_UPLOAD_CRON=
# SUB_STORE_PRODUCE_CRON=
# SUB_STORE_DATA_URL=
# SUB_STORE_DATA_URL_POST=

# Optional path-prefix mode. If SUB_STORE_BACKEND_PREFIX is enabled, the path
# must start with "/", for example /2cXaAxRGfddmGz2yx1wA.
# SUB_STORE_FRONTEND_BACKEND_PATH=/2cXaAxRGfddmGz2yx1wA
# SUB_STORE_BACKEND_PREFIX=true
