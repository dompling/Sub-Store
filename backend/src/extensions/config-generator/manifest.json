{
    "schemaVersion": 1,
    "id": "org.substore.config-generator",
    "kind": "bundled",
    "distribution": "bundled",
    "name": "配置生成器",
    "description": "生成 Surge、Quantumult X、Clash 和 Loon 配置",
    "version": "1.0.0",
    "publisher": {
        "id": "org.substore",
        "name": "Sub-Store",
        "verified": true
    },
    "license": "GPL-3.0",
    "homepage": "https://github.com/sub-store-org/Sub-Store",
    "host": {
        "apiVersion": "1.0.0",
        "backend": ">=2.36.31",
        "runtimes": [
            "node",
            "qx",
            "loon",
            "surge",
            "stash",
            "shadowrocket",
            "egern"
        ]
    },
    "entrypoints": {
        "backend": {
            "mode": "bundled",
            "key": "configGeneratorBackend"
        }
    },
    "permissions": [
        {
            "name": "storage.own",
            "reason": "保存配置项目与规则集"
        },
        {
            "name": "resources.read",
            "scope": ["subscriptions", "collections", "files", "artifacts"],
            "reason": "把现有节点与文件融合到配置项目"
        },
        {
            "name": "network.fetch",
            "scope": ["user-configured-https", "user-configured-http"],
            "reason": "读取用户配置的远程订阅和规则集"
        },
        {
            "name": "artifact.produce",
            "scope": ["subscription", "collection", "file", "rule"]
        },
        {
            "name": "artifact-source.register",
            "scope": ["config-project"]
        },
        {
            "name": "routes.namespaced"
        },
        {
            "name": "navigation.register"
        }
    ],
    "contributes": {
        "features": ["org.substore.config-generator.configGenerator"],
        "routes": [
            "org.substore.config-generator.list",
            "org.substore.config-generator.edit",
            "org.substore.config-generator.import",
            "org.substore.config-generator.preview",
            "org.substore.config-generator.download"
        ],
        "artifactSources": [
            {
                "id": "org.substore.config-generator.config-project",
                "type": "config-project",
                "labelKey": "artifactSource",
                "platforms": ["Surge", "QX", "Clash", "Loon"]
            }
        ],
        "navigation": ["org.substore.config-generator.main"],
        "pageActions": [
            "org.substore.config-generator.add",
            "org.substore.config-generator.import"
        ]
    },
    "scriptExecutionLanes": {
        "simple": {
            "product": "sub-store-0",
            "implementationId": "org.substore.config-generator@1/simple",
            "routes": [
                "projects",
                "projects/:name",
                "project/:name",
                "rule-sets",
                "rule-set/:name"
            ]
        },
        "parser": {
            "product": "sub-store-1",
            "implementationId": "org.substore.config-generator@1/parser",
            "routes": [
                "preview/:target",
                "import/:target",
                "download/config-project/**"
            ]
        }
    },
    "storage": {
        "schemaVersion": 1,
        "legacyKeys": ["configGenerator"]
    },
    "legacy": {
        "id": "config-generator",
        "feature": "configGenerator",
        "routes": [
            "/api/extensions/config-generator/**",
            "/download/config-project/**"
        ]
    }
}
